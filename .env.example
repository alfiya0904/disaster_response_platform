# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/disaster_db?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/disaster_db?retryWrites=true&w=majority

# Server Port (Render sets this automatically; defaults to 3000 for local development)
PORT=3000